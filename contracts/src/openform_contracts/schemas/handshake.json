{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": "openform.activity/1"
    },
    "phase": {
      "enum": [
        "init",
        "ready",
        "connect"
      ]
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "protocolVersion",
    "phase",
    "nonce"
  ],
  "additionalProperties": false
}
