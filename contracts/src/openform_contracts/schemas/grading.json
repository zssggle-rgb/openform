{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "maxItems": 100,
  "items": {
    "type": "object",
    "properties": {
      "questionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "rule": {
        "const": "equals"
      },
      "expected": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "points": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 100
      }
    },
    "required": [
      "questionId",
      "rule",
      "expected",
      "points"
    ],
    "additionalProperties": false
  }
}
