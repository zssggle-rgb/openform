of.openforgeai.cn {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow, noarchive"
		Cache-Control "no-store"
	}

	@private path /.env* /.git* /Caddyfile /docker-compose*
	respond @private 404

	header /healthz Content-Type "application/json; charset=utf-8"
	respond /healthz "{\"status\":\"ready\",\"service\":\"openform-test-gateway\",\"application\":\"not_deployed\"}" 200

	header / Content-Type "text/plain; charset=utf-8"
	respond / "OpenForm 测试环境已就绪。HTTPS 已启用。应用尚未部署，等待工程开发。环境检查：https://of.openforgeai.cn/healthz" 200
	respond "OpenForm 应用尚未部署。" 404
}
